module ElasticGraph
  class GraphQL
    module Aggregation
      class Computation
        attr_reader source_field_path: fieldPath
        attr_reader leaf: PathSegment
        attr_reader function_adapter: FunctionAdapter::adapter
        attr_reader function_args: FunctionAdapter::functionArgs

        def key: (aggregation_name: ::String) -> ::String
        def clause: () -> ::Hash[::String, untyped]

        def initialize : (
          source_field_path: fieldPath,
          leaf: PathSegment,
          function_adapter: FunctionAdapter::adapter,
          function_args: FunctionAdapter::functionArgs
        ) -> void

        def with: (
          ?source_field_path: fieldPath,
          ?leaf: PathSegment,
          ?function_adapter: FunctionAdapter::adapter,
          ?function_args: FunctionAdapter::functionArgs
        ) -> instance
      end
    end
  end
end
