module ElasticGraph
  class GraphQL
    module Aggregation
      module Resolvers
        class GroupedBySupertype
          attr_reader bucket: ::Hash[::String, untyped]
          attr_reader field_path: ::Array[PathSegment]

          def initialize: (
            bucket: ::Hash[::String, untyped],
            field_path: ::Array[PathSegment]
          ) -> void

          def self.new: (
            bucket: ::Hash[::String, untyped],
            field_path: ::Array[PathSegment]
          ) -> instance | (
            ::Hash[::String, untyped],
            ::Array[PathSegment]
          ) -> instance

          def with: (
            ?bucket: ::Hash[::String, untyped],
            ?field_path: ::Array[PathSegment]
          ) -> instance
        end

        class GroupedBy < GroupedBySupertype
          include _GraphQLResolvableWithLookahead

          def key_value_for: (field: Schema::Field, lookahead: ::GraphQL::Execution::Lookahead) -> untyped

          private

          def field_path_for: (Schema::Field, ::GraphQL::Execution::Lookahead) -> ::Array[PathSegment]

          def work_around_terms_aggregation_boolean_value: (untyped) -> untyped
        end
      end
    end
  end
end
