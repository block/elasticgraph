module ElasticGraph
  class Indexer
    module IngestionAdapter
      interface _Adapter
        def validate_event: (event, ?skip_record_validation: bool) -> ValidationResult
      end

      class Interface
        include _Adapter
      end

      class FailureSupertype < ::Data
        attr_reader validation_target: ::String
        attr_reader message: ::String

        def initialize: (validation_target: ::String, message: ::String) -> void
        def self.new: (validation_target: ::String, message: ::String) -> instance
        def self.members: () -> ::Array[::Symbol]
      end

      class Failure < FailureSupertype
      end

      class ValidationResultSupertype < ::Data
        attr_reader record_preparer: _RecordPreparer?
        attr_reader failure: Failure?

        def initialize: (record_preparer: _RecordPreparer?, failure: Failure?) -> void
        def self.new: (record_preparer: _RecordPreparer?, failure: Failure?) -> instance
        def self.members: () -> ::Array[::Symbol]
      end

      class ValidationResult < ValidationResultSupertype
        def self.valid: (_RecordPreparer) -> ValidationResult
        def self.invalid: (validation_target: ::String, message: ::String) -> ValidationResult
      end
    end
  end
end
