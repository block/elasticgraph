module ElasticGraph
  class Indexer
    module Operation
      class Result
        type category = :failure | :noop | :success

        attr_reader category: category
        attr_reader operation: operation
        attr_reader description: ::String?

        def initialize: (
          category: category,
          operation: operation,
          description: ::String?) -> void

        attr_reader operation_type: operationType
        attr_reader event: ::Hash[::String, untyped]
        attr_reader event_id: EventID
        attr_reader summary: ::String

        def self.success_of: (operation) -> Result
        def self.noop_of: (operation, ::String?) -> Result
        def self.failure_of: (operation, ::String?) -> Result
      end
    end
  end
end
