module ElasticGraph
  module ProtoIngestion
    class RecordPreparer
      @metadata: RuntimeMetadata::Schema
      @scalar_types_by_name: Hash[String, SchemaArtifacts::RuntimeMetadata::ScalarType]
      @types: Hash[Class, Type]
      @enums: Hash[Google::Protobuf::EnumDescriptor, Hash[Symbol | Integer, String?]]
      @mutex: Mutex

      def initialize: (schemaArtifacts) -> void
      def prepare_for_index: (String, untyped, Hash[String, untyped]?) -> Hash[String, untyped]?

      class Type < ::Data
        attr_reader name: String
        attr_reader fields: Array[Field]?
        def self.new: (String, Array[Field]?) -> Type
      end

      class Field < ::Data
        attr_reader name: String
        attr_reader name_in_index: String
        attr_reader presence_method: Symbol?
        attr_reader list_depth: Integer
        attr_reader leaf_preparer: (^(untyped) -> untyped)?
        def self.new: (String, String, Symbol?, Integer, (^(untyped) -> untyped)?) -> Field
      end

      private

      def prepare_message: (untyped, Hash[String, untyped]?) -> Hash[String, untyped]?
      def prepare_value: (Field, untyped, Integer, Hash[String, untyped]?) -> untyped
      def build_type: (Google::Protobuf::Descriptor) -> Type
      def build_field: (Google::Protobuf::Descriptor, Google::Protobuf::FieldDescriptor, RuntimeMetadata::Field?) -> Field
      def build_enum: (Google::Protobuf::EnumDescriptor) -> Hash[Symbol | Integer, String?]
      def build_scalar_preparer: (Google::Protobuf::FieldDescriptor, RuntimeMetadata::Field?) -> ^(untyped) -> untyped
      def type_name_for: (Google::Protobuf::Descriptor | Google::Protobuf::EnumDescriptor) -> String
    end
  end
end
