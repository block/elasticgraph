module ElasticGraph
  module ProtoIngestion
    class RecordValidator
      TIMESTAMP_SECONDS_RANGE: Range[Integer]
      TIMESTAMP_NANOS_RANGE: Range[Integer]
      WIRE_CONTRACT_SCALARS: Set[String]
      SCALAR_CHECKS: Hash[String, ^(untyped) -> boolish]

      def self.valid_date?: (String) -> boolish
      def self.valid_timestamp?: (untyped) -> bool
      def self.valid_json?: (String) -> bool

      @metadata: RuntimeMetadata::Schema
      @types: Hash[untyped, Type]
      @mutex: Mutex

      def initialize: (RuntimeMetadata::Schema) -> void
      def error_for: (untyped, ?String, ?wire_contract_only: bool) -> String?

      class Type < ::Data
        attr_reader fields: Array[Field]?
        def self.new: (Array[Field]?) -> Type
      end

      class Field < ::Data
        attr_reader name: String
        attr_reader presence_method: Symbol?
        attr_reader list_depth: Integer
        attr_reader nested_message: bool
        attr_reader wire_contract: bool
        attr_reader error_suffix: String?
        attr_reader leaf_check: (^(untyped) -> boolish)?
        def self.new: (String, Symbol?, Integer, bool, bool, String?, (^(untyped) -> boolish)?) -> Field
      end

      private

      def validate_value: (Field, untyped, Integer, String, bool) -> String?
      def build_type: (Google::Protobuf::Descriptor) -> Type
      def build_field: (Google::Protobuf::Descriptor, Google::Protobuf::FieldDescriptor, RuntimeMetadata::Field?) -> Field?
      def build_scalar_field: (String, Symbol?, Integer, Google::Protobuf::FieldDescriptor, RuntimeMetadata::Field?) -> Field?
      def type_name_for: (Google::Protobuf::Descriptor) -> String
    end
  end
end
