#!/usr/bin/env bash

# Abort script at first error, when a command exits with non-zero status.
# Verbose form of `set -e`.
set -o errexit

# Attempting to use an undefined variable outputs an error message and forces an exit.
# Verbose form of `set -u`.
set -o nounset

# If set, the return value of a pipeline is the value of the last (rightmost)
# command to exit with a non-zero status, or zero if all commands in the
# pipeline exit successfully.
set -o pipefail

# Unfortunately, one of steep's dependencies crashes when you use frozen string literals,
# so we disable that flag when running it here.
#
# Steep's background typecheck workers can log an `ERROR:` diagnostic (e.g. a recovered
# RBS/subtyping crash) without that affecting the process exit status, so `steep check`
# can exit 0 even though it hit a real problem. Tee its output to a log (so progress still
# streams live) and fail explicitly if any such line shows up, so those warnings can't
# silently pass CI.
log=$(mktemp)
trap 'rm -f "$log"' EXIT

RUBYOPT=--disable-frozen-string-literal bundle exec steep check 2>&1 | tee "$log"
status="${PIPESTATUS[0]}"

if [ "$status" -ne 0 ]; then
  exit "$status"
fi

if grep -q "ERROR:" "$log"; then
  echo "script/type_check: steep logged an ERROR diagnostic; treating it as a failure." >&2
  exit 1
fi
